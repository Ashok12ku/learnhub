# Copy this file to `.env` and fill in real values for production.
# For local development, you can leave everything commented out —
# the app works out of the box with SQLite + local media storage.

# ---- Core ----
# Generate one with: python -c "from django.core.management.utils import get_random_secret_key; print(get_random_secret_key())"
SECRET_KEY=change-me-to-a-real-random-secret-key
DEBUG=False
ALLOWED_HOSTS=learnhub.example.com,www.learnhub.example.com
CSRF_TRUSTED_ORIGINS=https://learnhub.example.com,https://www.learnhub.example.com
TIME_ZONE=Asia/Kolkata

# ---- Database (PostgreSQL) ----
# Railway/Render give you this automatically when you attach a Postgres addon.
# Format: postgres://USER:PASSWORD@HOST:PORT/DBNAME
DATABASE_URL=postgres://user:password@host:5432/learnhub_db

# ---- Media storage (Cloudinary) ----
# Sign up free at https://cloudinary.com — needed because platforms like
# Railway/Render wipe local disk storage on every redeploy.
USE_CLOUDINARY=True
CLOUDINARY_CLOUD_NAME=your_cloud_name
CLOUDINARY_API_KEY=your_api_key
CLOUDINARY_API_SECRET=your_api_secret

# ---- Razorpay (LIVE keys for real payments) ----
RAZORPAY_KEY_ID=rzp_test_TVvIzEpcX2wFUC
RAZORPAY_KEY_SECRET=3PsNodTDtU4g3I7gVI1lzVuF